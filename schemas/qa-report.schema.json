{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroday0619.github.io/kisa-cce-guide/schemas/qa-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "canonicalCorpusChecksum",
    "testProfileVersion",
    "browserEngine",
    "browserVersion",
    "validationStatus",
    "passed",
    "evidencePaths"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "reportType": {"enum": ["accessibility", "responsive", "print"]},
    "canonicalCorpusChecksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "testProfileVersion": {"type": "integer", "minimum": 1},
    "browserEngine": {"type": "string", "minLength": 1},
    "browserVersion": {"type": "string", "minLength": 1},
    "validationStatus": {"enum": ["passed", "failed"]},
    "passed": {"type": "boolean"},
    "evidencePaths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
