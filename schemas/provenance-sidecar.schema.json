{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroday0619.github.io/kisa-cce-guide/schemas/provenance-sidecar.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "criterionSlug", "sourceDocumentIdentifier", "blockProvenance", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "criterionSlug": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "sourceDocumentIdentifier": {"type": "string", "minLength": 1},
    "blockProvenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/blockProvenance"}
    },
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "boundingBox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalPage", "printedPage", "pageRegionIdentifier"],
      "properties": {
        "physicalPage": {"type": "integer", "minimum": 1},
        "printedPage": {"type": "string", "minLength": 1},
        "pageRegionIdentifier": {"type": "string", "minLength": 1},
        "sourceBoundingBox": {"$ref": "#/$defs/boundingBox"}
      }
    },
    "blockProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSpans"],
      "properties": {
        "blockReference": {"type": "string", "minLength": 1},
        "blockReferences": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "blockType": {"type": "string", "minLength": 1},
        "headingLevel": {"type": "integer", "minimum": 1, "maximum": 6},
        "semanticRole": {"type": "string", "minLength": 1},
        "publicationDisposition": {"enum": ["published", "derived", "excluded"]},
        "derivationType": {"type": "string", "minLength": 1},
        "sourceSpans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceSpan"}
        }
      },
      "oneOf": [
        {"required": ["blockReference"], "not": {"required": ["blockReferences"]}},
        {"required": ["blockReferences"], "not": {"required": ["blockReference"]}}
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "assetType",
        "renderingProfileIdentifier",
        "checksumAlgorithm",
        "checksumValue",
        "alternativeText",
        "alternativeTextStatus",
        "originalPixelDimensions",
        "outputPixelDimensions",
        "sourceCrop",
        "sourceSpans"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "assetType": {"enum": ["sourceImage", "sourcePageCrop", "webOptimizedDerivative"]},
        "renderingProfileIdentifier": {"type": "string", "minLength": 1},
        "checksumAlgorithm": {"const": "sha256"},
        "checksumValue": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "alternativeText": {"type": "string"},
        "alternativeTextStatus": {"enum": ["verificationRequired", "reviewed"]},
        "caption": {"type": ["string", "null"]},
        "originalPixelDimensions": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "outputPixelDimensions": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "sourceCrop": {"$ref": "#/$defs/boundingBox"},
        "sourceSpans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceSpan"}}
      }
    }
  }
}
