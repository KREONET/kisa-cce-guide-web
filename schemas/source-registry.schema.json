{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroday0619.github.io/kisa-cce-guide/schemas/source-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documents"],
  "properties": {
    "schemaVersion": {"const": 2},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceDocument"}
    }
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "license": {"type": "string", "minLength": 1},
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocumentIdentifier",
        "title",
        "publisher",
        "publicationDate",
        "sourceUrl",
        "repositoryPath",
        "fileSizeBytes",
        "physicalPageCount",
        "checksumAlgorithm",
        "checksumValue",
        "license"
      ],
      "properties": {
        "sourceDocumentIdentifier": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "publicationDate": {"type": "string", "format": "date"},
        "sourceUrl": {"type": "string", "format": "uri"},
        "repositoryPath": {"type": "string", "minLength": 1},
        "fileSizeBytes": {"type": "integer", "minimum": 1},
        "physicalPageCount": {"type": "integer", "minimum": 1},
        "checksumAlgorithm": {"const": "sha256"},
        "checksumValue": {"$ref": "#/$defs/checksum"},
        "license": {"$ref": "#/$defs/license"}
      }
    }
  }
}
