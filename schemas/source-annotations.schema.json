{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroday0619.github.io/kisa-cce-guide/schemas/source-annotations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "annotations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annotationIdentifier",
          "annotationType",
          "targetType",
          "targetReference",
          "sourceDocumentIdentifier",
          "physicalPage",
          "sourceText",
          "explanation",
          "disposition",
          "reviewStatus",
          "verificationEvidence",
          "reviewedBy",
          "reviewedAt"
        ],
        "properties": {
          "annotationIdentifier": {"type": "string", "minLength": 1},
          "annotationType": {
            "enum": [
              "sourceInconsistency",
              "sourceDuplication",
              "sourceOmission",
              "sourceTypographicalError",
              "missingReference",
              "conversionDecision"
            ]
          },
          "targetType": {"enum": ["pageRegion", "navigation", "document"]},
          "targetReference": {"type": "string", "minLength": 1},
          "sourceDocumentIdentifier": {"type": "string", "minLength": 1},
          "physicalPage": {"type": "integer", "minimum": 1},
          "sourceText": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["preserved", "correctedWithNotice", "unresolved"]},
          "reviewStatus": {"enum": ["pending", "reviewed"]},
          "verificationEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "replacementText": {"type": "string", "minLength": 1},
          "reviewedBy": {"type": ["string", "null"]},
          "reviewedAt": {"type": ["string", "null"], "format": "date-time"},
          "approvedBy": {"type": ["string", "null"]},
          "approvedAt": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
