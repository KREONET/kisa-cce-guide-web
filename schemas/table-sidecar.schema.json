{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroday0619.github.io/kisa-cce-guide/schemas/table-sidecar.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "criterionSlug", "tables"],
  "properties": {
    "schemaVersion": {"const": 1},
    "criterionSlug": {"type": "string", "minLength": 1},
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tableIdentifier", "caption", "headers", "rows", "sourceSpans"],
        "properties": {
          "tableIdentifier": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "headers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rows": {
            "type": "array",
            "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "sourceSpans": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
