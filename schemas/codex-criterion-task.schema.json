{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroday0619.github.io/kisa-cce-guide/schemas/codex-criterion-task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskIdentifier",
    "taskChecksum",
    "promptVersion",
    "promptTemplateChecksum",
    "resultSchemaChecksum",
    "conversionPolicyChecksum",
    "criterionCode",
    "criterionSlug",
    "criterionTitle",
    "domainIdentifier",
    "categoryIdentifier",
    "contentModel",
    "criterionSourceChecksum",
    "sourceDocumentIdentifier",
    "sourceDocumentChecksum",
    "sourcePageStart",
    "sourcePageEnd",
    "evidenceContract",
    "sourcePageEvidence",
    "requiredTechnicalLiterals",
    "paths"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 2},
    "taskIdentifier": {"type": "string", "pattern": "^[a-z0-9-]+-codex-structure-v[0-9]+$"},
    "taskChecksum": {"$ref": "#/$defs/checksum"},
    "promptVersion": {"type": "integer", "minimum": 1},
    "promptTemplateChecksum": {"$ref": "#/$defs/checksum"},
    "resultSchemaChecksum": {"$ref": "#/$defs/checksum"},
    "conversionPolicyChecksum": {"$ref": "#/$defs/checksum"},
    "criterionCode": {"type": "string", "minLength": 1},
    "criterionSlug": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "criterionTitle": {"type": "string", "minLength": 1},
    "domainIdentifier": {"type": "string", "minLength": 1},
    "categoryIdentifier": {"type": "string", "minLength": 1},
    "contentModel": {"type": "string", "const": "extractedCriterion"},
    "criterionSourceChecksum": {"$ref": "#/$defs/checksum"},
    "sourceDocumentIdentifier": {"type": "string", "minLength": 1},
    "sourceDocumentChecksum": {"$ref": "#/$defs/checksum"},
    "sourcePageStart": {"type": "integer", "minimum": 1},
    "sourcePageEnd": {"type": "integer", "minimum": 1},
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualAuthority",
        "transcriptRole",
        "visionInspectionRequired",
        "typedSemanticNodesRequired",
        "transcriptOnlyResultAllowed",
        "uncertaintyMustBePreserved",
        "provenanceMustBePreserved"
      ],
      "properties": {
        "visualAuthority": {"type": "string", "const": "sourcePageImages"},
        "transcriptRole": {"type": "string", "const": "navigationAid"},
        "visionInspectionRequired": {"type": "boolean", "const": true},
        "typedSemanticNodesRequired": {"type": "boolean", "const": true},
        "transcriptOnlyResultAllowed": {"type": "boolean", "const": false},
        "uncertaintyMustBePreserved": {"type": "boolean", "const": true},
        "provenanceMustBePreserved": {"type": "boolean", "const": true}
      }
    },
    "sourcePageEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pageEvidence"}
    },
    "requiredTechnicalLiterals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionMarkdown",
        "criterionProvenance",
        "conversionPolicy",
        "promptTemplate",
        "resultSchema",
        "structuredExemplars"
      ],
      "properties": {
        "criterionMarkdown": {"type": "string", "minLength": 1},
        "criterionProvenance": {"type": "string", "minLength": 1},
        "conversionPolicy": {"type": "string", "minLength": 1},
        "promptTemplate": {"type": "string", "minLength": 1},
        "resultSchema": {"type": "string", "minLength": 1},
        "structuredExemplars": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalPage",
        "printedPage",
        "pageRegionIdentifier",
        "transcript",
        "imagePath",
        "imageChecksum"
      ],
      "properties": {
        "physicalPage": {"type": "integer", "minimum": 1},
        "printedPage": {"type": "string", "minLength": 1},
        "pageRegionIdentifier": {"type": "string", "minLength": 1},
        "transcript": {"type": "string", "minLength": 1},
        "imagePath": {"type": "string", "minLength": 1},
        "imageChecksum": {"$ref": "#/$defs/checksum"}
      }
    }
  }
}
