{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroday0619.github.io/kisa-cce-guide/schemas/codex-agent-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskIdentifier",
    "taskChecksum",
    "status",
    "analysisStatus",
    "reviewedPhysicalPages",
    "unresolvedQuestions"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "taskIdentifier": {"type": "string", "minLength": 1},
    "taskChecksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "const": "candidateWritten"},
    "analysisStatus": {
      "type": "string",
      "enum": ["complete", "needsSourceReview"]
    },
    "reviewedPhysicalPages": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
